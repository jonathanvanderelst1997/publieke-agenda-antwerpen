{
  "name": "publieke-agenda-antwerpen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-agenda.mjs",
    "build:provenance-sla": "node scripts/build-provenance-sla.mjs",
    "build:provenance-snapshot": "node scripts/build-provenance-snapshot.mjs",
    "test:source-diff-replay": "node --test tests/source-diff-replay.test.mjs",
    "test:stale-policy": "node --test tests/stale-policy.test.mjs",
    "test:deep-links": "node scripts/test-deep-links.mjs",
    "test:individual-ics": "node scripts/test-individual-ics.mjs",
    "test:site-quality": "node scripts/test-site-quality.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:events": "node scripts/audit-events.mjs",
    "check": "npm run build && npm run build:provenance-sla && npm run build:provenance-snapshot && npm run lint && npm test && npm run audit:events && npm run test:deep-links && npm run test:individual-ics && npm run test:site-quality"
  },
  "engines": { "node": ">=20" }
}

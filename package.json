{
  "name": "publieke-agenda-antwerpen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sources": "node scripts/build-sources.mjs",
    "build": "node scripts/build-agenda.mjs",
    "build:provenance-sla": "node scripts/build-provenance-sla.mjs",
    "build:provenance-snapshot": "node scripts/build-provenance-snapshot.mjs",
    "test:source-diff-replay": "node --test tests/source-diff-replay.test.mjs",
    "test:stale-policy": "node --test tests/stale-policy.test.mjs",
    "test:deep-links": "node scripts/test-deep-links.mjs",
    "test:individual-ics": "node scripts/test-individual-ics.mjs",
    "test:site-quality": "node scripts/test-site-quality.mjs",
    "test:render-headers": "node scripts/test-render-security-headers.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.e2e.mjs",
    "audit:events": "node scripts/audit-events.mjs",
    "check": "npm run build:sources && npm run build && npm run build:provenance-sla && npm run build:provenance-snapshot && npm run lint && npm test && npm run audit:events && npm run test:deep-links && npm run test:individual-ics && npm run test:site-quality && npm run test:render-headers",
    "build:all": "npm run build:sources && npm run build && npm run build:provenance-sla && npm run build:provenance-snapshot",
    "refresh:fetch": "node scripts/refresh-fetch.mjs",
    "geo:refresh": "node scripts/geocode-locations.mjs",
    "geo:wijken": "node scripts/build-wijken.mjs",
    "geo:straten": "node scripts/build-straten.mjs",
    "refresh:manual": "node scripts/check-manual-sources.mjs",
    "refresh": "npm run refresh:fetch && npm run build:sources && npm run refresh:manual && npm run geo:refresh && npm run build:all",
    "validate:data": "node scripts/validate-data.mjs",
    "sources:health": "node scripts/sources-health.mjs",
    "check:data-lane": "node scripts/check-data-lane.mjs"
  },
  "engines": { "node": ">=20" }
}
